# =============================================================================
# Backend (server.mjs) — load via dotenv if you run Node locally, or set in Vercel
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://www.anupaatnivesh.com

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=onboarding-documents
SUPABASE_ONBOARDING_TABLE=onboarding_submissions
# Optional: instant basket analytics on Vercel Cron (without waiting for git deploy)
# Create table: basket_analytics_cache (id text PK, payload jsonb, updated_at timestamptz)
SUPABASE_BASKET_ANALYTICS_TABLE=basket_analytics_cache

# Basket analytics cron (Vercel Cron + manual trigger) — set on Vercel only
CRON_SECRET=replace_with_long_random_secret
BASKET_ADMIN_SECRET=replace_with_admin_secret

RESEND_API_KEY=re_xxxxxxxxxxxxx
ONBOARDING_ALERT_TO_EMAIL=ops@anupaatnivesh.com
ONBOARDING_ALERT_FROM_EMAIL=KYC Bot <noreply@yourdomain.com>

# Contact / lead forms (Resend — replaces fragile EmailJS+Gmail OAuth on production)
# Use a verified domain in Resend for FROM (e.g. info@anupaatnivesh.com)
CONTACT_ALERT_TO_EMAIL=info@anupaatnivesh.com
CONTACT_ALERT_FROM_EMAIL=Anupaat Nivesh <info@anupaatnivesh.com>

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

MEDIA_ADMIN_USERNAME=admin
MEDIA_ADMIN_PASSWORD_HASH=$2a$12$replace_with_real_hash
MEDIA_SESSION_SECRET=replace_with_long_random_secret
MEDIA_UPLOAD_DIR=./uploads/media
MEDIA_FILES_BASE_URL=http://localhost:8000/media-files

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=anupaat_db
DB_USER=anupaat_user
DB_PASSWORD=replace_with_password

# --- Optional: Google Custom Search (factsheet batch job, 100 free queries/day) ---
