# =============================================================================
# Local environment (Create your own file — not committed to git)
#   cp .env.example .env
#   # or (CRA prefers this for secrets):  cp .env.example .env.local
# Then restart: npm start  and  npm run server  (port 3000 UI, port 8000 API + proxy)
# npm start sets DANGEROUSLY_DISABLE_HOST_CHECK for CRA when proxy is enabled (avoids allowedHosts error).
#
# Dev server note: package.json "proxy" enables webpack host-check. If you see
# "allowedHosts[0] should be a non-empty string", npm start already sets
# DANGEROUSLY_DISABLE_HOST_CHECK=true via cross-env. Do not set NODE_ENV=production in .env for local dev.
#
# For a production bundle uploaded to Hostinger while API stays on Vercel, use instead:
#   .env.production.hostinger.example  →  copy to .env.production before `npm run build`
# =============================================================================

# --- API base (React) ---------------------------------------------------------
# Leave EMPTY for local dev with package.json "proxy" → /api/* goes to :8000
# and MarketTicker uses same-origin /api/market-ticker (recommended).
# If set, use ORIGIN ONLY — no trailing /api (e.g. wrong: https://x.vercel.app/api → /api/api/... → 404).
# src/api/config.js still uses http://localhost:8000 in development when this is unset/empty.
# For Vercel single deploy: leave empty in dashboard too (same-origin /api).
REACT_APP_API_BASE_URL=

# --- Site & SEO -------------------------------------------------------------
REACT_APP_BASE_URL=http://localhost:3000
REACT_APP_AMFI_ARN=ARN-347085

# --- WhatsApp ---------------------------------------------------------------
REACT_APP_WHATSAPP_NUMBER=919501185200

# --- Razorpay (public key only; secrets stay on server / Vercel env) --------
REACT_APP_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
REACT_APP_CONSULTING_SESSION_PRICE=999
REACT_APP_CONSULTING_SESSION_ACTUAL_PRICE=999

# --- Calendly ---------------------------------------------------------------
REACT_APP_CALENDLY_CONSULTING_URL=https://calendly.com/anupaatnivesh/financial-planning-session
REACT_APP_CALENDLY_URL=https://calendly.com/anupaatnivesh
# REACT_APP_CALENDLY_API_TOKEN=

# --- EmailJS (legacy — contact forms now use Resend via /api/contact/submit) ---
# Keep only if REACT_APP_CONTACT_USE_EMAILJS=true for local dev fallback
# REACT_APP_EMAILJS_SERVICE_ID=
# REACT_APP_EMAILJS_TEMPLATE_ID=
# REACT_APP_EMAILJS_MF_TEMPLATE_ID=
# REACT_APP_EMAILJS_PUBLIC_KEY=

# --- Ops / booking ----------------------------------------------------------
REACT_APP_ADMIN_EMAIL=info@anupaatnivesh.com

# --- Optional: onboarding iframe --------------------------------------------
