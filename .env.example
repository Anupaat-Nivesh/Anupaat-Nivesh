# Anupaat Nivesh - Environment Variables
# Copy this file to .env and update with your actual values

# ============================================
# WhatsApp Integration
# ============================================
# WhatsApp number in international format (without + or spaces)
# Example: 919876543210 for +91 98765 43210
REACT_APP_WHATSAPP_NUMBER=919501185200

# ============================================
# Razorpay Payment Integration
# ============================================
# Razorpay Key ID (public key - safe for frontend)
# Get this from Razorpay Dashboard > Settings > API Keys
# Note: Secret key should ONLY be used in backend, never in frontend .env
REACT_APP_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# Consulting Session Pricing (in INR)
REACT_APP_CONSULTING_SESSION_PRICE=99
REACT_APP_CONSULTING_SESSION_ACTUAL_PRICE=9999

# ============================================
# Calendly Integration
# ============================================
# Calendly Event URL for consulting sessions
# Get this from Calendly > Event Types > Share > Copy Link
REACT_APP_CALENDLY_CONSULTING_URL=https://calendly.com/anupaatnivesh/financial-planning-session
# Fallback Calendly URL (optional)
REACT_APP_CALENDLY_URL=https://calendly.com/anupaatnivesh

# ============================================
# EmailJS Integration (Contact Forms)
# ============================================
REACT_APP_EMAILJS_SERVICE_ID=service_f3brm8k
REACT_APP_EMAILJS_TEMPLATE_ID=template_agep8yl
REACT_APP_EMAILJS_MF_TEMPLATE_ID=template_abk1zsr
REACT_APP_EMAILJS_PUBLIC_KEY=9UdH6e5xO7yZCJSL5

# ============================================
# SEO & Site Configuration
# ============================================
# Base URL for canonical URLs and Open Graph images
# Example: https://www.anupaatnivesh.com
REACT_APP_BASE_URL=https://www.anupaatnivesh.com

# ============================================
# Backend API Configuration
# ============================================
# Backend API base URL for payment and booking operations
# Development: http://localhost:8000
# Production: https://api.anupaatnivesh.com
# Leave empty for development mode (uses mock data)
REACT_APP_API_BASE_URL=http://localhost:8000

# ============================================
# Client Onboarding (Supabase + Resend)
# ============================================
# Optional frontend display
REACT_APP_AMFI_ARN=ARN-347085

# Backend CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://www.anupaatnivesh.com

# Supabase project settings (backend only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=onboarding-documents
SUPABASE_ONBOARDING_TABLE=onboarding_submissions

# Resend email alerts (backend only)
RESEND_API_KEY=re_xxxxxxxxxxxxx
ONBOARDING_ALERT_TO_EMAIL=ops@anupaatnivesh.com
ONBOARDING_ALERT_FROM_EMAIL=KYC Bot <noreply@yourdomain.com>

# ============================================
# Internal — Media Admin (backend)
# ============================================
# Admin login for /mediadata
MEDIA_ADMIN_USERNAME=admin
# Generate with: node -e "const b=require('bcryptjs');console.log(b.hashSync('StrongPasswordHere',12))"
MEDIA_ADMIN_PASSWORD_HASH=$2a$12$replace_with_real_hash
MEDIA_SESSION_SECRET=replace_with_long_random_secret

# Hostinger / Node media upload serving
MEDIA_UPLOAD_DIR=./uploads/media
# Public base URL for uploaded files (can be relative if same server serves files)
MEDIA_FILES_BASE_URL=https://www.anupaatnivesh.com/media-files

# MySQL (Hostinger)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=anupaat_db
DB_USER=anupaat_user
DB_PASSWORD=replace_with_password
