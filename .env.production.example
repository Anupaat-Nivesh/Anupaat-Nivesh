NODE_ENV=production
CI=false

# -----------------------------------------------------------------------------
# Vercel (single project: CRA static + Express server.mjs for /api/*)
# -----------------------------------------------------------------------------
# Build: Vercel runs `npm run vercel-build` if present, else `npm run build`.
# `build` uses cross-env so GENERATE_SOURCEMAP works on Linux (Vercel), not only Windows cmd.
#
# Frontend — unified same-origin API (ticker, health, payments, …):
#   Leave REACT_APP_API_BASE_URL empty/unset so the browser calls /api/... on the SAME host
#   as the deployed site (e.g. https://www.anupaatnivesh.com/api/market-ticker).
#   Only set REACT_APP_API_BASE_URL if the React app is hosted separately from server.mjs.
#
# Optional: add your preview/production domains to CORS via CORS_ALLOWED_ORIGINS (comma-separated).
# *.vercel.app is allowed by default for previews.
# -----------------------------------------------------------------------------
REACT_APP_API_BASE_URL=
REACT_APP_WHATSAPP_NUMBER=919501195200
REACT_APP_BASE_URL=https://www.anupaatnivesh.com
REACT_APP_AMFI_ARN=ARN-347085

# Backend - payment secrets
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Backend - onboarding stack
CORS_ALLOWED_ORIGINS=https://www.anupaatnivesh.com,https://anupaatnivesh.com

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=onboarding-documents
SUPABASE_ONBOARDING_TABLE=onboarding_submissions
RESEND_API_KEY=re_xxxxxxxxxxxxx
ONBOARDING_ALERT_TO_EMAIL=ops@anupaatnivesh.com
ONBOARDING_ALERT_FROM_EMAIL=KYC Bot <noreply@yourdomain.com>
