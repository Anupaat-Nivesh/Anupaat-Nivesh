Options -MultiViews
RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Canonical host: apex → www
RewriteCond %{HTTP_HOST} ^anupaatnivesh\.com$ [NC]
RewriteRule ^ https://www.anupaatnivesh.com%{REQUEST_URI} [L,R=301]

# Short calculator share links: /s/edu2 → /s/edu2/index.html (OG preview pages)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/s/$1/index.html -f
RewriteRule ^s/([a-z0-9-]+)/?$ /s/$1/index.html [L,QSA]

# Never rewrite real files/dirs (assets, share HTML, og images, calculators/, screeners/, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback — serve index.html for all other client routes
RewriteRule ^ index.html [L,QSA]

# Hostinger/hCDN may surface missing paths as 404 before rewrite
ErrorDocument 404 /404.html
