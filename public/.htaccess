Options -MultiViews
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Canonical host: apex → www (site already published on www.anupaatnivesh.com)
RewriteCond %{HTTP_HOST} ^anupaatnivesh\.com$ [NC]
RewriteRule ^ https://www.anupaatnivesh.com%{REQUEST_URI} [L,R=301]

# Short calculator share folders: /s/sip → /s/sip/ (DirectoryIndex = index.html with OG tags)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/s/$1/index.html -f
RewriteRule ^s/([a-z0-9-]+)/?$ /s/$1/ [L,R=301]

# SPA fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]
