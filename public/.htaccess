Options -MultiViews
DirectoryIndex index.html
RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Canonical host: apex → www
RewriteCond %{HTTP_HOST} ^anupaatnivesh\.com$ [NC]
RewriteRule ^ https://www.anupaatnivesh.com%{REQUEST_URI} [L,R=301]

# Short calculator share links: /s/edu2 → /s/edu2/index.html (OG preview pages)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/s/$1/index.html -f
RewriteRule ^s/([a-z0-9-]+)/?$ /s/$1/index.html [L,QSA]

# If a mirrored SPA folder exists, serve its index (cold links / trailing-slash variants)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L,QSA]

# Existing files/dirs (assets, og, static, mirrored routes, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback for dynamic paths (invest/fund/:code, etc.) when Apache sees the request
RewriteRule ^ index.html [L,QSA]

# When the panel/CDN surfaces a 404, prefer our SPA shell
ErrorDocument 404 /404.html
