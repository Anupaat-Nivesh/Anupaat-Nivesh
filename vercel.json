{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "/api/$1"
    },
    {
      "src": "^/(static|favicon.ico|manifest.json|robots.txt|asset-manifest.json)/(.*)?$",
      "dest": "/$0"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}