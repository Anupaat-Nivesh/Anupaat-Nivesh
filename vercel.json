{
    "version": 2,
    "crons": [
        {
            "path": "/api/baskets/cron/refresh",
            "schedule": "35 17 * * *"
        }
    ],
    "builds": [
        {
            "src": "server.mjs",
            "use": "@vercel/node"
        },
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "build"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/server.mjs"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ],
    "env": {
        "NODE_ENV": "production"
    }
}