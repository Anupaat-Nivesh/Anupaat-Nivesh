# =============================================================================
# Production build when React static files are on Hostinger and API is on Vercel
# Full step-by-step checklist: docs/DEPLOY_HOSTINGER_VERCEL.md
# =============================================================================
# 1) Copy this file to .env.production (or merge into your CI secrets):
#      cp .env.production.hostinger.example .env.production
# 2) Fill REACT_APP_API_BASE_URL with your Vercel backend ORIGIN (no /api suffix).
# 3) npm run build   → upload the `build/` folder to Hostinger.
# 4) On Vercel: set CORS_ALLOWED_ORIGINS to your EXACT public site origin(s), comma-separated.
#    Example: https://www.anupaatnivesh.com,https://anupaatnivesh.com
#    If you use a Hostinger temporary URL, include it too while testing.
# 5) Redeploy Vercel after changing env vars.
#
# Debug from the Hostinger site (browser devtools → Network):
#   - Open your homepage, find a failed API request.
#   - If status is (failed) or CORS error: fix CORS_ALLOWED_ORIGINS on Vercel (exact scheme+host+port).
#   - If 404 on .../api/api/... : REACT_APP_API_BASE_URL must NOT end with /api (origin only).
#
# Sanity check in a new tab (while logged into nothing special):
#   fetch('https://YOUR-VERCEL-ORIGIN/api/health').then(r=>r.json()).then(console.log)
#   You should see JSON { status, requestOrigin } — requestOrigin may be null from address bar.
# =============================================================================

NODE_ENV=production
CI=false

# Vercel deployment origin ONLY (examples — replace with yours):
#   https://anupaat-nivesh.vercel.app
#   or a custom domain that points to the same Vercel project
REACT_APP_API_BASE_URL=https://anupaat-nivesh.vercel.app

# Public URL where users open the React app (Hostinger) — SEO / canonicals
REACT_APP_BASE_URL=https://www.anupaatnivesh.com

REACT_APP_WHATSAPP_NUMBER=919501195200
REACT_APP_AMFI_ARN=ARN-347085

# Razorpay public key (same as you use today)
REACT_APP_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
REACT_APP_CONSULTING_SESSION_PRICE=999
REACT_APP_CONSULTING_SESSION_ACTUAL_PRICE=999

REACT_APP_CALENDLY_CONSULTING_URL=https://calendly.com/anupaatnivesh/financial-planning-session
REACT_APP_CALENDLY_URL=https://calendly.com/anupaatnivesh

